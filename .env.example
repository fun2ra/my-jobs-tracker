# Copy to .env (git-ignored) and fill in. See SETUP.md for where to find each value.
# These end up in the published JavaScript: put IDs here, never secrets.

# Google Cloud → Credentials → OAuth client ID (…apps.googleusercontent.com)
VITE_GOOGLE_CLIENT_ID=

# Apps Script → Project Settings → IDs → Script ID (not the deployment ID)
VITE_APPS_SCRIPT_ID=

# Optional: the only Google account the app accepts. Leave empty to rely on the
# OAuth consent screen's test users (the address would be readable on the published site).
VITE_ALLOWED_EMAIL=
